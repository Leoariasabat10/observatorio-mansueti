# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# edición de video: intermedios pesados (los editables y exportes viven en video-final/)
/video-final/work/
/video-final/_analisis/*.wav
/video-final/composicion/*/assets/arese-1080.mp4
/video-final/composicion/*/.hyperframes/
/video-final/composicion/*/node_modules/
/video-final/exports/
/*.mp4
